{
  "name": "duxweb/dux-lite",
  "type": "library",
  "description": "The lightweight framework based on slim php",
  "keywords": [
    "PHP framework",
    "PHP",
    "slim",
    "duxphp"
  ],
  "homepage": "https://github.com/duxphp",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/duxweb/dux-lite/issues",
    "source": "https://github.com/duxweb/dux-lite"
  },
  "authors": [
    {
      "name": "dux",
      "email": "admin@dux.plus"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.4",
    "ext-zlib": "*",
    "ext-pdo": "*",
    "php-di/php-di": "^7.0",
    "nesbot/carbon": "^3.8",
    "nette/utils": "^4.0",
    "hassankhan/config": "^3.1",
    "vlucas/phpdotenv": "^5.6",
    "latte/latte": "^3.0",
    "symfony/event-dispatcher": "^7.1",
    "devium/toml": "^1.0",
    "monolog/monolog": "^3.7",
    "symfony/console": "^7.1",
    "symfony/process": "^7.1",
    "illuminate/database": "^11.30",
    "illuminate/pagination": "^11.30",
    "illuminate/events": "^11.30",
    "doctrine/dbal": "^4.2",
    "fileeye/mimemap": "^2.2",
    "slim/psr7": "^1.7",
    "nunomaduro/termwind": "^2.2",
    "symfony/var-dumper": "^7.1",
    "predis/predis": "^2.2",
    "symfony/cache": "^7.1",
    "symfony/lock": "^7.1",
    "firebase/php-jwt": "^7.0",
    "tuupola/slim-basic-auth": "^2.1",
    "jimtools/jwt-auth": "^3.0",
    "slim/slim": "4.*",
    "willdurand/negotiation": "^3.1",
    "aws/aws-sdk-php": "^3.326",
    "vlucas/valitron": "^1.4",
    "kalnoy/nestedset": "^6.0",
    "zoujingli/ip2region": "^2.0",
    "eftec/bladeone": "^4.16",
    "peppeocchi/php-cron-scheduler": "^4.0",
    "react/event-loop": "^1.5",
    "composer/composer": "^2.8",
    "ezyang/htmlpurifier": "^4.18",
    "masterminds/html5": "^2.10",
    "symfony/messenger": "^7.4"
  },
  "suggest": {
    "symfony/redis-messenger": "使用 Redis 队列后端需要（同时需要 ext-redis）",
    "symfony/amqp-messenger": "使用 AMQP 队列后端需要（同时需要 ext-amqp）"
  },
  "require-dev": {
    "pestphp/pest": "^3.5",
    "pestphp/pest-plugin-stressless": "^3.0",
    "mockery/mockery": "^1.6"
  },
  "autoload": {
    "psr-4": {
      "Core\\": "src/",
      "Core\\Tests\\": "tests"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "*": true
    }
  },
  "scripts": {
    "test": "./vendor/bin/pest"
  }
}
